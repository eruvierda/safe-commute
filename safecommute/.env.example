APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=change_this_to_a_random_32_char_secret_key_in_production

# MariaDB / MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=safecommute
DB_USER=root
DB_PASS=

# Session Lifetime (seconds, 30 days)
SESSION_LIFETIME=2592000

# Rate Limits (hits per window)
RATE_LIMIT_REPORT=10
RATE_LIMIT_VOTE=60
RATE_LIMIT_AUTH=15
RATE_LIMIT_WINDOW=3600

# Proxy & Nominatim Settings
USER_AGENT=SafeCommute-Rumahweb/1.0 (contact@safecommute.local)
